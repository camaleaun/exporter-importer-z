---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import { url } from '@libs/site';
---

<BaseLayout title="Page not found" description="This page isn’t here. Try the docs or go back home.">
	<div class="container not-found">
		<p class="eyebrow">404</p>
		<h1>This page didn’t make the trip.</h1>
		<p class="lead">It may have moved. The docs list every page.</p>
		<p class="actions">
			<Button href={ url() }>Home</Button>
			<Button href={ url( 'docs/' ) } variant="secondary">Docs</Button>
		</p>
	</div>
</BaseLayout>

<style>
	.not-found {
		padding-block: var(--eiz-space-24);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--eiz-space-3);
	}
</style>
