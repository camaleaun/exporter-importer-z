---
/**
 * A screenshot in a frame: a browser window (desktop) or a phone. AVIF and
 * WebP at the widths the layout needs, with its size set (no layout shift);
 * lazy unless `eager` (the hero's, which is the LCP).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	frame?: 'browser' | 'phone';
	sizes?: string;
	eager?: boolean;
	caption?: string;
}

const { src, alt, frame = 'browser', sizes, eager = false, caption } = Astro.props;
const widths = frame === 'phone' ? [ 280, 390, 560, 780 ] : [ 480, 720, 960, 1280, 1600, 2000 ];
const defaultSizes =
	frame === 'phone'
		? '(min-width: 782px) 280px, 70vw'
		: '(min-width: 1280px) 720px, (min-width: 782px) 55vw, calc(100vw - 2rem)';
---

<figure class:list={[ 'shot', `shot--${ frame }` ]}>
	<div class="shot__frame">
		{
			frame === 'browser' && (
				<div class="shot__bar" aria-hidden="true">
					<span />
					<span />
					<span />
				</div>
			)
		}
		<Picture
			src={ src }
			alt={ alt }
			formats={ [ 'avif', 'webp' ] }
			widths={ widths }
			sizes={ sizes ?? defaultSizes }
			loading={ eager ? 'eager' : 'lazy' }
			decoding={ eager ? 'sync' : 'async' }
			fetchpriority={ eager ? 'high' : undefined }
			quality={ 72 }
		/>
	</div>
	{ caption && <figcaption>{ caption }</figcaption> }
</figure>

<style>
	.shot {
		margin: 0;
	}

	.shot__frame {
		overflow: hidden;
		background: var(--eiz-paper);
		box-shadow: var(--eiz-shadow-lg);
	}

	.shot--browser .shot__frame {
		border-radius: var(--eiz-radius);
		border: 1px solid var(--eiz-border);
	}

	.shot__bar {
		display: flex;
		gap: 6px;
		padding: 10px 12px;
		background: var(--eiz-surface);
		border-bottom: 1px solid var(--eiz-border);

		span {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: var(--eiz-border);
		}
	}

	.shot--phone .shot__frame {
		max-width: 280px;
		margin-inline: auto;
		border-radius: 36px;
		border: 10px solid #1e1e1e;
	}

	.shot :global(img) {
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: var(--eiz-space-3);
		color: var(--eiz-muted);
		font-size: var(--eiz-text-sm);
		text-align: center;
	}
</style>
