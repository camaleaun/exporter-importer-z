{
	"extends": "astro/tsconfigs/strict",
	"include": [ ".astro/types.d.ts", "**/*" ],
	"exclude": [ "dist" ],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@components/*": [ "src/components/*" ],
			"@layouts/*": [ "src/layouts/*" ],
			"@libs/*": [ "src/libs/*" ],
			"@assets/*": [ "src/assets/*" ]
		}
	}
}
