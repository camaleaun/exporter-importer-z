<?xml version="1.0"?>
<ruleset name="Eizport">
	<description>WordPress Coding Standards for Eizport.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!-- Generated by @wordpress/build (routes/ → build/). -->
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/site/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="eizport"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="eizport"/>
				<element value="Eizport"/>
			</property>
		</properties>
	</rule>

	<!-- PHPUnit needs *Test.php files; test method names describe themselves.
	     bin/release.php is a dev tool with a fixed name (the wp-release-command pattern), not shipped. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/php/*Test.php</exclude-pattern>
	</rule>
</ruleset>
