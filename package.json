{
	"name": "eizport",
	"private": true,
	"description": "Development tools for the Eizport plugin.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-build && node bin/postbuild.mjs",
		"dev": "wp-build --watch",
		"check-types": "tsc --noEmit",
		"readme": "grunt readme"
	},
	"devDependencies": {
		"@types/react": "18.3.28",
		"@wordpress/abilities": "0.17.0",
		"@wordpress/admin-ui": "2.6.0",
		"@wordpress/base-styles": "11.0.0",
		"@wordpress/build": "0.19.0",
		"@wordpress/components": "37.0.0",
		"@wordpress/compose": "8.4.0",
		"@wordpress/core-abilities": "0.16.0",
		"@wordpress/data": "10.51.0",
		"@wordpress/dataviews": "17.2.0",
		"@wordpress/date": "5.51.0",
		"@wordpress/element": "8.3.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/i18n": "6.24.0",
		"@wordpress/icons": "15.2.0",
		"@wordpress/notices": "5.51.0",
		"@wordpress/route": "0.17.0",
		"@wordpress/ui": "0.18.0",
		"grunt": "^1.6.1",
		"grunt-wp-readme-to-markdown": "^2.1.0",
		"typescript": "5.9.3"
	},
	"wpPlugin": {
		"name": "eizport",
		"scriptGlobal": false,
		"packageNamespace": "eizport",
		"handlePrefix": "eizport",
		"pages": [
			"eizport-export",
			"eizport-settings"
		]
	}
}
